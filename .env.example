# Copy to .env and fill in.  chmod 600 .env — it holds secrets.

# ---- Tier 0: the server to watch (works with zero cooperation) ----
MC_HOST=play.example.com
MC_PORT=25565

# ---- Tier 1: RCON. Leave RCON_PASSWORD blank to disable. ----
# The owner sets these in server.properties:
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=<something long and random>
# RCON is UNENCRYPTED. Only point this at a private address (Tailscale/WireGuard)
# or an SSH tunnel — never at a raw public IP.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=

# ---- Tier 2: the agent. Leave blank to refuse agent connections outright. ----
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# ---- Dashboard login ----
ADMIN_USER=admin
# Generate with: python -m app.hashpw
ADMIN_PASSWORD_HASH=
# Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
# If unset, a random key is used and every restart signs you out.
SECRET_KEY=
SESSION_HOURS=168
# Set to false ONLY if you are testing over plain http on the LAN.
SECURE_COOKIE=true

POLL_SECONDS=10
