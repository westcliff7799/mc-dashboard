[Unit]
Description=Tick the Minecraft Dashboard supervisor

[Timer]
# Late enough after boot that the dashboard has had a chance to serve its first
# poll — probing a service that is still starting would just log noise.
OnBootSec=90s
OnUnitActiveSec=15s
AccuracySec=1s
Unit=mc-dashboard-supervise.service

[Install]
WantedBy=timers.target
